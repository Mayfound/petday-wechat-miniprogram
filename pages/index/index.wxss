page { min-height:100vh; background:#f7f8fa; color:#1f2329; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif; }
.page-scroll { height:100vh; } .page-shell { min-height:100%; box-sizing:border-box; padding:44rpx 28rpx 0; }
.topbar { display:flex; align-items:center; justify-content:space-between; margin:0 4rpx 30rpx; }.greeting-mini { display:block; color:#999fa9; font-size:19rpx; letter-spacing:1.4rpx; }.greeting { display:block; margin-top:7rpx; font-size:42rpx; line-height:1.2; font-weight:700; letter-spacing:-1rpx; }.avatar-button { width:72rpx; height:72rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#fff; box-shadow:0 6rpx 18rpx rgba(31,35,41,.08); font-size:34rpx; }
.pet-card { height:316rpx; position:relative; overflow:hidden; border-radius:28rpx; background:linear-gradient(135deg,#8d73d9,#a58ee6 62%,#cabcf2); box-shadow:0 15rpx 34rpx rgba(105,82,174,.24); }.pet-card:after { content:""; position:absolute; width:360rpx; height:360rpx; right:-160rpx; top:-180rpx; border-radius:50%; background:rgba(255,255,255,.12); }.pet-copy { position:relative; z-index:2; padding:37rpx 0 0 32rpx; color:#fff; }.pet-name-row { display:flex; align-items:center; gap:9rpx; }.pet-name { font-size:52rpx; font-weight:700; letter-spacing:-2rpx; }.gender { padding-top:6rpx; color:#f9e5ff; font-size:26rpx; }.pet-desc { display:block; margin-top:6rpx; color:rgba(255,255,255,.80); font-size:22rpx; }.level-chip { width:205rpx; display:flex; align-items:center; gap:8rpx; margin-top:24rpx; padding:10rpx 12rpx; border-radius:20rpx; background:rgba(255,255,255,.17); color:#fff; font-size:17rpx; }.exp-track { flex:1; height:7rpx; overflow:hidden; border-radius:7rpx; background:rgba(255,255,255,.28); }.exp-fill { height:100%; border-radius:7rpx; background:#fff; transition:width 520ms cubic-bezier(.22,.75,.3,1); }
.pet-stage { position:absolute; z-index:3; right:-6rpx; bottom:0; width:345rpx; height:316rpx; transition:transform 160ms ease; }.pet-circle { position:absolute; top:34rpx; right:48rpx; width:205rpx; height:205rpx; border-radius:50%; background:rgba(255,244,211,.55); }.pet-image { position:absolute; z-index:3; right:7rpx; bottom:0; width:264rpx; height:299rpx; filter:drop-shadow(0 12rpx 12rpx rgba(65,45,91,.22)); transform-origin:50% 90%; }.idle-image { opacity:1; animation:pet-float 3.6s ease-in-out infinite; }.lick-image { opacity:0; transition:opacity 130ms ease; }.pet-bubble { position:absolute; z-index:5; right:13rpx; bottom:22rpx; padding:8rpx 12rpx; border-radius:17rpx; color:#6f5b9d; background:#fff; box-shadow:0 6rpx 13rpx rgba(53,37,89,.13); font-size:17rpx; }.pet-spark { position:absolute; z-index:4; color:#fff; font-size:24rpx; text-shadow:0 0 10rpx rgba(255,255,255,.6); }.spark-one { left:38rpx; top:46rpx; animation:twinkle 2.4s ease-in-out infinite; }.spark-two { right:25rpx; top:92rpx; font-size:16rpx; animation:twinkle 2.4s 1s ease-in-out infinite; }
.pet-stage.is-licking .idle-image,.pet-stage.cat-licking .idle-image { opacity:0; animation:none; }.pet-stage.is-licking .lick-image,.pet-stage.cat-licking .lick-image { opacity:1; animation:lick-groom 780ms ease-in-out infinite; }.pet-stage.is-licking .pet-bubble,.pet-stage.cat-licking .pet-bubble { color:#c66f8a; }.pet-stage.pet-active .pet-image { animation:pet-cheer 720ms cubic-bezier(.2,.85,.3,1) both; }.pet-stage.mood-play .idle-image { animation-duration:2.35s; }.pet-stage.mood-love .pet-circle { background:rgba(255,222,233,.55); }.pet-stage:active { transform:scale(.97); }
.summary-row { display:flex; align-items:center; justify-content:space-around; margin-top:20rpx; padding:22rpx 0; border-radius:22rpx; background:#fff; box-shadow:0 6rpx 20rpx rgba(31,35,41,.045); }.summary-item { width:30%; text-align:center; }.summary-value { display:block; color:#282b31; font-size:31rpx; font-weight:700; }.summary-label { display:block; margin-top:7rpx; color:#9298a3; font-size:18rpx; }.summary-divider { width:1rpx; height:42rpx; background:#eceef1; }
.section-heading { margin:39rpx 4rpx 20rpx; }.section-title { display:block; font-size:30rpx; line-height:1.3; font-weight:700; }.section-subtitle { display:block; margin-top:5rpx; color:#959ba5; font-size:20rpx; }.status-list { padding:2rpx 22rpx; border-radius:22rpx; background:#fff; box-shadow:0 6rpx 20rpx rgba(31,35,41,.045); }.status-item { display:flex; align-items:center; padding:22rpx 0; border-bottom:1rpx solid #f0f1f3; transition:transform 180ms ease, background 180ms ease; }.status-item:last-child { border:0; }.status-icon { width:54rpx; height:54rpx; display:flex; align-items:center; justify-content:center; border-radius:17rpx; font-size:26rpx; }.status-icon.peach { color:#e87f58; background:#fff0e9; }.status-icon.pink { color:#db7690; background:#ffedf2; }.status-icon.purple { color:#846aca; background:#f0edff; }.status-main { flex:1; margin-left:17rpx; }.status-line { display:flex; justify-content:space-between; align-items:center; color:#4a4e55; font-size:22rpx; }.status-line text:last-child { color:#777e88; font-size:20rpx; }.progress-track { height:8rpx; overflow:hidden; margin-top:11rpx; border-radius:10rpx; background:#f0f1f3; }.progress-fill { height:100%; border-radius:10rpx; transition:width 520ms cubic-bezier(.22,.75,.3,1); }.progress-fill.peach { background:#f3a17f; }.progress-fill.pink { background:#e999af; }.progress-fill.purple { background:#a091dd; }.status-pulse { animation:status-pop 600ms cubic-bezier(.2,.85,.3,1); }
.wish-card { display:flex; align-items:center; margin-top:18rpx; padding:21rpx 20rpx; border-radius:22rpx; background:#f1efff; }.wish-icon { width:55rpx; height:55rpx; flex:0 0 55rpx; border-radius:18rpx; display:flex; align-items:center; justify-content:center; color:#846ccc; background:#e3ddff; font-size:28rpx; }.wish-copy { flex:1; min-width:0; margin-left:15rpx; }.wish-title { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#353143; font-size:24rpx; font-weight:600; }.wish-desc { display:block; margin-top:6rpx; color:#85818f; font-size:18rpx; }.checkin-btn { flex:0 0 auto; height:60rpx; margin:0 0 0 12rpx; padding:0 21rpx; line-height:60rpx; border-radius:30rpx; color:#fff; background:#846bce; font-size:20rpx; font-weight:600; }.checkin-btn:after,.action-item:after { border:0; }.btn-press { transform:scale(.95); opacity:.9; }
.action-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16rpx; }.action-item { min-width:0; margin:0; padding:21rpx 8rpx 17rpx; border-radius:20rpx; background:#fff; box-shadow:0 5rpx 16rpx rgba(31,35,41,.04); text-align:center; line-height:normal; transition:transform 160ms ease, box-shadow 160ms ease; }.action-press { transform:scale(.95); box-shadow:0 3rpx 10rpx rgba(31,35,41,.04); }.action-icon { width:62rpx; height:62rpx; margin:0 auto 12rpx; border-radius:19rpx; display:flex; align-items:center; justify-content:center; font-size:29rpx; }.peach-bg { background:#fff0e7; }.purple-bg { background:#efecff; color:#7e68c2; }.pink-bg { background:#ffedf3; color:#d97d96; }.action-title { display:block; color:#363a40; font-size:23rpx; font-weight:600; }.action-meta { display:block; margin-top:5rpx; color:#a0a5ad; font-size:17rpx; }.plan-card { display:flex; align-items:center; margin-top:28rpx; padding:21rpx; border-radius:22rpx; background:#fff; box-shadow:0 6rpx 20rpx rgba(31,35,41,.045); }.plan-icon { width:64rpx; height:64rpx; flex:0 0 64rpx; display:flex; align-items:center; justify-content:center; border-radius:20rpx; background:#fff0e4; font-size:31rpx; }.plan-copy { flex:1; min-width:0; margin-left:16rpx; }.plan-label { display:block; color:#a38ad0; font-size:15rpx; font-weight:700; letter-spacing:1rpx; }.plan-title { display:block; margin-top:5rpx; font-size:24rpx; font-weight:600; }.plan-desc { display:block; margin-top:5rpx; color:#969ba4; font-size:18rpx; }.arrow { color:#abb0b8; font-size:42rpx; }.bottom-space { height:174rpx; }
.tabbar { position:fixed; z-index:20; right:0; bottom:0; left:0; height:116rpx; padding-bottom:env(safe-area-inset-bottom); box-sizing:content-box; display:flex; align-items:center; justify-content:space-around; border-top:1rpx solid #eceef1; background:rgba(255,255,255,.97); }.tab-item { min-width:76rpx; display:flex; flex-direction:column; align-items:center; gap:3rpx; color:#8d949e; font-size:17rpx; }.tab-item.active { color:#8069c8; font-weight:600; }.tab-icon { height:33rpx; line-height:33rpx; font-size:31rpx; }.tab-add { width:78rpx; height:78rpx; margin-top:-42rpx; display:flex; align-items:center; justify-content:center; border:7rpx solid #f7f8fa; border-radius:50%; color:#fff; background:#846bce; box-shadow:0 8rpx 17rpx rgba(105,82,174,.26); font-size:48rpx; font-weight:300; }
@keyframes pet-float { 0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-7rpx) rotate(-1deg)} } @keyframes twinkle { 0%,100%{opacity:.35;transform:scale(.75)}50%{opacity:1;transform:scale(1.12)} } @keyframes lick-groom { 0%,100%{transform:translateY(0) rotate(0)}45%{transform:translateY(-4rpx) rotate(-1.5deg)} } @keyframes pet-cheer { 0%{transform:scale(1)}45%{transform:translateY(-13rpx) scale(1.06) rotate(2deg)}100%{transform:scale(1)} } @keyframes status-pop { 0%,100%{transform:scale(1)}45%{transform:scale(1.025);background:#faf9ff} }
@media (max-width: 330px) { .page-shell { padding-right:20rpx; padding-left:20rpx; }.pet-copy { padding-left:25rpx; }.pet-stage { right:-22rpx; transform:scale(.92); transform-origin:right bottom; }.pet-desc { font-size:20rpx; }.level-chip { width:185rpx; }.wish-card { padding-right:15rpx; padding-left:15rpx; }.checkin-btn { padding-right:16rpx; padding-left:16rpx; } }

/* 宠物与猫爪双主角：猫爪是明确、独立的主互动入口 */
.pet-card { background:linear-gradient(128deg,#735bc1 0%,#9378dd 50%,#d5b6df 100%); }.pet-card:before { content:""; position:absolute; z-index:1; right:-66rpx; bottom:-123rpx; width:410rpx; height:250rpx; border-radius:50%; background:rgba(255,255,255,.12); transform:rotate(-21deg); }.pet-copy { z-index:4; }.pet-stage { z-index:3; }.paw-action { position:absolute; z-index:9; left:28rpx; bottom:25rpx; min-width:142rpx; height:72rpx; box-sizing:border-box; display:flex; align-items:center; gap:11rpx; padding:8rpx 13rpx 8rpx 9rpx; border:1rpx solid rgba(255,255,255,.42); border-radius:36rpx; color:#fff; background:rgba(255,255,255,.18); box-shadow:0 8rpx 20rpx rgba(61,42,112,.18),inset 0 1rpx rgba(255,255,255,.23); backdrop-filter:blur(10rpx); -webkit-backdrop-filter:blur(10rpx); transition:transform 180ms cubic-bezier(.2,.8,.3,1),background 180ms ease; }.paw-icon { width:54rpx; height:54rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#fff; box-shadow:0 4rpx 12rpx rgba(52,35,94,.16); font-size:29rpx; }.paw-action text:first-child { display:block; font-size:21rpx; font-weight:700; line-height:1.15; }.paw-action text:last-child { display:block; margin-top:4rpx; color:rgba(255,255,255,.78); font-size:15rpx; }.paw-press { transform:scale(.94); background:rgba(255,255,255,.31); }.paw-action.pawing { animation:paw-bump 850ms cubic-bezier(.2,.85,.3,1) both; background:rgba(255,255,255,.34); }.paw-action.pawing .paw-icon { animation:paw-icon-pop 680ms cubic-bezier(.2,.85,.3,1) both; }.paw-active-card:after { animation:card-flash 700ms ease-out both; }.paw-active-card .pet-circle { animation:paw-aura 850ms ease-out both; }
@keyframes paw-bump { 0%{transform:scale(1)}32%{transform:translateY(-13rpx) scale(1.1)}58%{transform:translateY(2rpx) scale(.96)}100%{transform:scale(1)} } @keyframes paw-icon-pop { 0%{transform:rotate(0) scale(1)}42%{transform:rotate(-18deg) scale(1.22)}70%{transform:rotate(9deg) scale(.98)}100%{transform:rotate(0) scale(1)} } @keyframes paw-aura { 0%{transform:scale(1);opacity:.55}45%{transform:scale(1.18);opacity:.93}100%{transform:scale(1);opacity:.55} } @keyframes card-flash { 0%{box-shadow:0 15rpx 34rpx rgba(105,82,174,.24)}45%{box-shadow:0 20rpx 50rpx rgba(255,229,174,.42)}100%{box-shadow:0 15rpx 34rpx rgba(105,82,174,.24)} }
.paw-active-card { animation:card-flash 700ms ease-out both; }

/* 动作帧状态机：待机 PNG / 舔爪 GIF / 击掌 PNG 分别在交互中切换 */
.highfive-image { opacity:0; transition:opacity 100ms ease; }.pet-stage.is-highfive .idle-image,.pet-stage.is-highfive .lick-image { opacity:0; animation:none; }.pet-stage.is-highfive .highfive-image { opacity:1; animation:highfive-frame 850ms cubic-bezier(.2,.85,.3,1) both; }.pet-stage.is-highfive .pet-bubble { color:#e07482; background:#fff7f8; }.pet-stage.is-highfive .pet-circle { background:rgba(255,225,178,.75); }
@keyframes highfive-frame { 0%{transform:translateY(12rpx) scale(.92) rotate(-4deg);opacity:0}36%{transform:translateY(-11rpx) scale(1.06) rotate(3deg);opacity:1}65%{transform:translateY(-4rpx) scale(.99) rotate(-1deg);opacity:1}100%{transform:translateY(0) scale(1) rotate(0);opacity:1} }
@import "../../styles/mobile.wxss";

/* Text, pet stage and paw action occupy separate rows at every phone width. */
.pet-card { height:auto; border-radius:36px; padding:22px 20px 18px; box-sizing:border-box; background:linear-gradient(145deg,#8c75cf,#b096df 60%,#dbc4e9); box-shadow:0 12px 28px rgba(117,85,170,.16); }
.pet-copy { padding:0; display:block; }
.pet-name { max-width:85%; font-size:30px; line-height:1.3; letter-spacing:-.5px; overflow-wrap:break-word; }
.gender { font-size:17px; }
.pet-desc { font-size:14px; line-height:1.55; margin-top:5px; }
.level-chip { width:auto; max-width:220px; margin-top:12px; padding:9px 12px; box-sizing:border-box; border-radius:999px; font-size:12px; }
.exp-track { min-width:30px; height:4px; }.level-chip>text { flex-shrink:0; }
.pet-stage { position:relative; right:auto; bottom:auto; width:100%; height:240px; margin:8px auto 0; transform:none; }
.pet-image { width:230px; height:230px; right:50%; margin-right:-115px; bottom:8px; filter:none; }
.pet-circle { width:192px; height:192px; top:22px; right:50%; margin-right:-96px; background:rgba(255,246,225,.40); }
.pet-bubble { right:50%; bottom:3px; max-width:90%; transform:translateX(50%); padding:9px 15px; border-radius:999px; font-size:12px; white-space:nowrap; }
.spark-one { left:16%; top:45px; font-size:20px; }.spark-two { right:17%; top:75px; font-size:14px; }
.paw-action { position:relative; left:auto; bottom:auto; width:100%; min-height:54px; height:auto; margin:14px 0 0; padding:10px 18px; border-radius:999px; justify-content:center; box-sizing:border-box; line-height:normal; }
.paw-action:after { border:0; }.paw-icon { width:38px; height:38px; flex:0 0 38px; font-size:22px; }
.paw-action text:first-child { font-size:16px; }.paw-action text:last-child { font-size:12px; }
.summary-row { border-radius:28px; margin-top:16px; padding:20px 0; }.summary-value { font-size:23px; }.summary-label { font-size:12px; color:#797386; }.summary-divider { height:28px; }
.section-heading { margin:28px 4px 14px; }.section-title { font-size:19px; }.section-subtitle { font-size:13px; line-height:1.6; color:#7f788b; }
.status-list { padding:4px 18px; border-radius:28px; }.status-item { padding:16px 0; }.status-icon { width:40px; height:40px; flex:0 0 40px; border-radius:15px; font-size:20px; }.status-main { min-width:0; margin-left:13px; }.status-line { font-size:15px; }.status-line text:last-child { font-size:14px; }.progress-track { height:5px; margin-top:9px; }
.wish-card { flex-wrap:wrap; gap:12px; padding:18px; border-radius:28px; }.wish-icon { width:40px; height:40px; flex:0 0 40px; border-radius:15px; }.wish-copy { margin:0; }.wish-title { white-space:normal; overflow:visible; font-size:15px; line-height:1.5; word-break:break-word; }.wish-desc { font-size:12px; line-height:1.5; }.checkin-btn { min-height:44px; height:auto; line-height:44px; padding:0 18px; margin:0 0 0 auto; border-radius:999px; font-size:14px; }
.action-grid { gap:12px; }.action-item { border-radius:26px; padding:19px 6px 16px; }.action-icon { width:44px; height:44px; border-radius:17px; font-size:23px; }.action-title { font-size:15px; }.action-meta { font-size:12px; color:#81798e; }
.plan-card { padding:18px; margin-top:20px; border-radius:28px; gap:12px; }.plan-icon { width:44px; height:44px; flex:0 0 44px; border-radius:17px; }.plan-copy { margin:0; }.plan-label { font-size:10px; }.plan-title { font-size:15px; }.plan-desc { font-size:12px; line-height:1.6; white-space:normal; }.arrow { font-size:28px; }
.tabbar { height:66px; border:0; border-radius:28px 28px 0 0; box-shadow:0 -6px 24px rgba(63,45,93,.06); padding-bottom:0; padding-bottom:env(safe-area-inset-bottom); }
.tab-item { flex:1; min-width:44px; min-height:48px; justify-content:center; font-size:12px; }.tab-icon { height:24px; line-height:24px; font-size:24px; }
.tab-add { width:48px; height:48px; flex:0 0 48px; box-sizing:content-box; margin-top:-18px; border-width:5px; font-size:32px; }
.bottom-space { height:108px; height:calc(108px + env(safe-area-inset-bottom)); }
@media (max-width:359px) { .pet-card { padding:18px 16px 16px; border-radius:30px; }.pet-stage { height:215px; transform:none; }.pet-image { width:210px; height:210px; margin-right:-105px; }.pet-circle { width:174px; height:174px; margin-right:-87px; }.wish-copy { flex-basis:calc(100% - 52px); }.checkin-btn { width:100%; margin:0; }.action-grid { gap:8px; }.action-item { border-radius:22px; }.plan-card { padding:16px; } }
@media (min-width:430px) { .pet-stage { height:265px; }.pet-image { width:255px; height:255px; margin-right:-127.5px; }.pet-circle { width:214px; height:214px; margin-right:-107px; } }
@media (min-width:600px) { .tabbar { max-width:560px; margin:0 auto; }.pet-stage { height:280px; } }
@media (prefers-reduced-motion:reduce) { .idle-image,.pet-spark,.pet-stage.pet-active .pet-image,.pet-stage.is-highfive .highfive-image,.paw-action.pawing,.paw-action.pawing .paw-icon,.paw-active-card,.paw-active-card .pet-circle,.status-pulse { animation:none; }.progress-fill,.exp-fill,.pet-stage,.action-item { transition:none; } }

.intimacy-line { position:relative; z-index:4; display:flex; justify-content:space-between; margin:12px 6px 0; color:#fff; font-size:13px; line-height:1.5; }
.paw-action[disabled] { color:#fff; background:rgba(255,255,255,.30); }
.pet-stage.is-highfive .highfive-image { z-index:6; opacity:1; animation-duration:650ms; }
.paw-action.pawing { animation-duration:650ms; }
.paw-action,.paw-action.pawing { background:#fff7fc; color:#51416e; border:1px solid rgba(255,255,255,.9); }
.paw-action .paw-title { color:#51416e; font-size:16px; font-weight:700; }
.paw-action .paw-subtitle { color:#766281; font-size:12px; line-height:1.5; }
.paw-action.pawing .paw-title { color:#674c9b; }
.paw-icon { color:#8568b9; background:#efe5fa; }
.paw-copy { text-align:left; }
.pet-bubble { z-index:7; pointer-events:none; }
