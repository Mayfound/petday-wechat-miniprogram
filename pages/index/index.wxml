<scroll-view class="page-scroll" scroll-y="true" show-scrollbar="false">
  <view class="page-shell">
    <view class="topbar">
      <view><text class="greeting-mini">PETDAY · 陪伴日记</text><text class="greeting">早上好，Mayday</text></view>
      <view class="avatar-button" bindtap="navigate" data-url="/pages/profile/profile">🌷</view>
    </view>

    <view class="pet-card {{pawing ? 'paw-active-card' : ''}}">
      <view class="pet-copy"><view class="pet-name-row"><text class="pet-name">{{petName}}</text><text class="gender">♂</text></view><text class="pet-desc">今天也想和你一起去冒险，主人</text><view class="level-chip"><text>LV. {{level}}</text><view class="exp-track"><view class="exp-fill" style="width: {{exp}}%"></view></view><text>{{exp}}/100</text></view></view>
      <view class="pet-stage {{petMood}} {{interacting ? 'pet-active' : ''}} {{licking ? 'is-licking' : ''}} {{pawing ? 'is-highfive' : ''}}" bindtap="petInteract" bindtouchstart="startLick" bindtouchend="endLick" bindtouchcancel="endLick" hover-class="cat-licking" hover-start-time="20" hover-stay-time="80">
        <view class="pet-circle"></view><view class="pet-spark spark-one">✦</view><view class="pet-spark spark-two">✦</view>
        <image class="pet-image idle-image" src="/assets/naigai-hero-v2.png" mode="aspectFit"/>
        <image class="pet-image lick-image" src="/assets/naigai-groom.gif" mode="aspectFit"/>
        <image class="pet-image highfive-image" src="/assets/naigai-highfive-v2.png" mode="aspectFit"/>
        <view class="pet-bubble">{{petTag}}</view>
      </view>
      <button class="paw-action {{pawing ? 'pawing' : ''}}" bindtap="pawInteract" hover-class="paw-press"><view class="paw-icon">🐾</view><view class="paw-copy"><text class="paw-title">{{pawHint}}</text><text class="paw-subtitle">{{pawing ? pawFeedback : '和' + petName + '击掌'}}</text></view></button>
      <view class="intimacy-line"><text>♡ 亲密度</text><text>{{intimacy}} / 100</text></view>
    </view>

    <view class="summary-row"><view class="summary-item"><text class="summary-value">{{streak}}</text><text class="summary-label">连续陪伴</text></view><view class="summary-divider"></view><view class="summary-item"><text class="summary-value">{{coins}}</text><text class="summary-label">陪伴币</text></view><view class="summary-divider"></view><view class="summary-item"><text class="summary-value">{{level}}</text><text class="summary-label">当前等级</text></view></view>

    <view class="section-heading"><view><text class="section-title">今日状态</text><text class="section-subtitle">莫急，照顾好奶盖的每一种小情绪</text></view></view>
    <view class="status-list"><view class="status-item {{pulseKey === item.key ? 'status-pulse' : ''}}" wx:for="{{stats}}" wx:key="key"><view class="status-icon {{item.className}}">{{item.icon}}</view><view class="status-main"><view class="status-line"><text>{{item.label}}</text><text>{{item.value}}%</text></view><view class="progress-track"><view class="progress-fill {{item.className}}" style="width: {{item.value}}%"></view></view></view></view></view>

    <view class="wish-card"><view class="wish-icon">♡</view><view class="wish-copy"><text class="wish-title">{{moodMessage}}</text><text class="wish-desc">{{actionHint}}</text></view><button class="checkin-btn" bindtap="handleCheckin" hover-class="btn-press">{{checkedIn ? '已打卡' : '去打卡'}}</button></view>

    <view class="section-heading"><view><text class="section-title">陪它做点什么</text><text class="section-subtitle">一点点互动，使得与它积累更多亲密</text></view></view>
    <view class="action-grid"><button class="action-item" wx:for="{{actions}}" wx:key="key" data-key="{{item.key}}" bindtap="handleAction" hover-class="action-press"><view class="action-icon {{item.className}}">{{item.icon}}</view><text class="action-title">{{item.title}}</text><text class="action-meta">+{{item.points}} {{item.target}}</text></button></view>

    <view class="plan-card" bindtap="navigate" data-url="/pages/activities/activities"><view class="plan-icon">🌇</view><view class="plan-copy"><text class="plan-label">TODAY'S PLAN</text><text class="plan-title">校园散步计划</text><text class="plan-desc">傍晚 17:30 · 和奶盖去看落日</text></view><text class="arrow">›</text></view>
    <view class="bottom-space"></view>
  </view>
</scroll-view>

<view class="tabbar"><view class="tab-item active"><text class="tab-icon">⌂</text><text>陪伴</text></view><view class="tab-item" bindtap="navigate" data-url="/pages/diary/diary"><text class="tab-icon">◌</text><text>日记</text></view><view class="tab-add" bindtap="handleCheckin">＋</view><view class="tab-item" bindtap="navigate" data-url="/pages/activities/activities"><text class="tab-icon">♧</text><text>乐园</text></view><view class="tab-item" bindtap="navigate" data-url="/pages/profile/profile"><text class="tab-icon">◯</text><text>我的</text></view></view>
