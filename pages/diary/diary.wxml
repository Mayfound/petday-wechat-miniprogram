<scroll-view class="page" scroll-y="true"><view class="wrap"><view class="top"><view><text class="eyebrow">MEMORIES WITH {{diary.length ? '奶盖' : 'PETDAY'}}</text><text class="title">陪伴日记</text></view><view class="back" bindtap="goBack">‹</view></view><view class="composer glass"><text class="composer-title">写下此刻</text><textarea value="{{input}}" maxlength="100" placeholder="{{placeholder}}" placeholder-class="placeholder" bindinput="inputChange" auto-height="true"></textarea><view class="composer-foot"><text>{{input.length}} / 100</text><button bindtap="saveDiary">保存记录</button></view></view><view class="timeline"><view class="timeline-item" wx:for="{{diary}}" wx:key="id"><view class="timeline-dot">{{item.icon}}</view><view class="entry glass"><text class="date">{{item.date}}</text><text class="entry-title">{{item.title}}</text><text class="entry-content">{{item.content}}</text></view></view></view><view class="safe"></view></view></scroll-view>
