page{background:#f6f5ff;color:#373447;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{height:100vh}.wrap{padding:52rpx 32rpx}.top{display:flex;justify-content:space-between;align-items:center;margin:0 8rpx 42rpx}.eyebrow,.date{display:block;color:#9b94ab;font-size:18rpx;letter-spacing:2rpx}.title{display:block;margin-top:10rpx;font-size:50rpx;font-weight:700;letter-spacing:-2rpx}.back{width:66rpx;height:66rpx;border-radius:25rpx;background:rgba(255,255,255,.72);display:flex;align-items:center;justify-content:center;font-size:48rpx;color:#7d7690}.glass{background:rgba(255,255,255,.66);border:2rpx solid rgba(255,255,255,.9);box-shadow:0 15rpx 40rpx rgba(83,65,138,.09);backdrop-filter:blur(20rpx)}.composer{padding:28rpx;border-radius:32rpx}.composer-title{font-size:27rpx;font-weight:700}.composer textarea{display:block;width:100%;min-height:125rpx;margin:18rpx 0 20rpx;font-size:25rpx;line-height:1.6}.placeholder{color:#aaa4b4}.composer-foot{display:flex;align-items:center;justify-content:space-between;color:#aaa3b4;font-size:19rpx}.composer button{margin:0;padding:0 25rpx;height:62rpx;line-height:62rpx;border-radius:32rpx;background:linear-gradient(135deg,#b39be8,#8875d0);color:#fff;font-size:21rpx}.composer button:after{border:0}.timeline{margin-top:36rpx;padding-left:18rpx;border-left:2rpx solid rgba(160,143,205,.25)}.timeline-item{position:relative;margin:0 0 25rpx 24rpx}.timeline-dot{position:absolute;left:-47rpx;top:23rpx;width:43rpx;height:43rpx;border-radius:17rpx;background:#fff;display:flex;align-items:center;justify-content:center;font-size:25rpx;box-shadow:0 7rpx 15rpx rgba(77,59,119,.09)}.entry{padding:23rpx 25rpx;border-radius:27rpx}.entry-title{display:block;margin-top:8rpx;font-size:26rpx;font-weight:700}.entry-content{display:block;margin-top:8rpx;color:#837d90;font-size:22rpx;line-height:1.55}.safe{height:55rpx}
.wrap{padding-bottom:calc(90rpx + env(safe-area-inset-bottom));}
@import "../../styles/mobile.wxss";
