page{background:#f6f5ff;color:#373447;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{height:100vh}.wrap{padding:52rpx 32rpx 90rpx}.top{display:flex;justify-content:space-between;align-items:center;margin:0 8rpx 42rpx}.eyebrow{display:block;color:#9b94ab;font-size:18rpx;letter-spacing:2rpx}.title{display:block;margin-top:10rpx;font-size:50rpx;font-weight:700;letter-spacing:-2rpx}.back{width:66rpx;height:66rpx;border-radius:25rpx;background:rgba(255,255,255,.72);display:flex;align-items:center;justify-content:center;font-size:48rpx;color:#7d7690}.hero{display:flex;align-items:center;justify-content:space-between;padding:30rpx;border-radius:35rpx;background:linear-gradient(135deg,#dcd1ff,#f4deef);box-shadow:0 16rpx 35rpx rgba(110,86,163,.14)}.hero-mini{display:block;color:#71658c;font-size:20rpx}.hero-num{display:block;margin-top:7rpx;font-size:48rpx;font-weight:700}.hero-num text{font-size:23rpx;color:#817690}.hero-desc{display:block;margin-top:5rpx;color:#777087;font-size:19rpx}.coin{padding:18rpx;border-radius:25rpx;background:rgba(255,255,255,.6);color:#8c70ca;font-size:28rpx;font-weight:700}.coin text{margin-left:5rpx;font-size:24rpx}.section{display:block;margin:42rpx 8rpx 20rpx;font-size:30rpx;font-weight:700}.glass{background:rgba(255,255,255,.66);border:2rpx solid rgba(255,255,255,.9);box-shadow:0 15rpx 40rpx rgba(83,65,138,.08)}.activity{display:flex;align-items:center;padding:21rpx;margin-top:15rpx;border-radius:29rpx}.act-icon{width:69rpx;height:69rpx;border-radius:25rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx}.sunset{background:#ffe5d5}.sky{background:#e0f3fc}.lavender{background:#ece7ff}.act-main{flex:1;margin-left:18rpx}.act-title,.tip view text:first-child{display:block;font-size:25rpx;font-weight:700}.act-time{display:block;margin-top:7rpx;color:#938d9d;font-size:19rpx}.activity button{margin:0;padding:0 20rpx;height:55rpx;line-height:55rpx;border-radius:28rpx;color:#fff;background:#967fd5;font-size:19rpx}.activity button:after{border:0}.done{width:48rpx;height:48rpx;border-radius:50%;background:#e4f4e9;color:#61aa79;display:flex;align-items:center;justify-content:center;font-size:25rpx}.is-done{opacity:.67}.tip{display:flex;gap:18rpx;align-items:flex-start;margin-top:35rpx;padding:25rpx;border-radius:29rpx}.tip>text{color:#a18adb;font-size:30rpx}.tip view text:last-child{display:block;margin-top:8rpx;color:#888294;font-size:20rpx;line-height:1.55}
.wrap{padding-bottom:calc(90rpx + env(safe-area-inset-bottom));}
