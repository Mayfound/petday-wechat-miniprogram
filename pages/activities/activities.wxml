<scroll-view class="page" scroll-y="true"><view class="wrap"><view class="top"><view><text class="eyebrow">CAMPUS MOMENTS</text><text class="title">校园乐园</text></view><view class="back" bindtap="goBack">‹</view></view><view class="hero"><view><text class="hero-mini">本周陪伴进度</text><text class="hero-num">{{doneCount}}<text> / {{activities.length}}</text></text><text class="hero-desc">完成小计划，给日常一点闪光</text></view><view class="coin">✦ <text>{{coins}}</text></view></view><text class="section">今天的计划</text><view class="activity glass {{item.done ? 'is-done' : ''}}" wx:for="{{activities}}" wx:key="id"><view class="act-icon {{item.color}}">{{item.icon}}</view><view class="act-main"><text class="act-title">{{item.title}}</text><text class="act-time">{{item.time}} · +{{item.points}} 陪伴币</text></view><button wx:if="{{!item.done}}" data-id="{{item.id}}" bindtap="finish">完成</button><view wx:else class="done">✓</view></view><view class="tip glass"><text>✦</text><view><text>陪伴小贴士</text><text>计划不用做得完美，和奶盖一起开始就很好。</text></view></view></view></scroll-view>
