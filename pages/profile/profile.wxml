<scroll-view class="page" scroll-y="true"><view class="wrap"><view class="top"><view><text class="eyebrow">MY PETDAY</text><text class="title">我的</text></view><view class="back" bindtap="goBack">‹</view></view><view class="profile-card glass"><view class="pet-avatar"><image src="/assets/naigai-hero-v2.png" mode="aspectFit"/></view><view class="profile-info"><text class="profile-name">{{petName}}</text><text>Lv. {{level}} · {{exp}} / 100 经验</text></view><view class="edit" bindtap="startEdit">编辑</view></view><view class="name-editor glass" wx:if="{{editing}}"><text>给小伙伴换个名字</text><input value="{{draftName}}" maxlength="10" bindinput="inputName" focus="true"/><view><button class="cancel" bindtap="cancelEdit">取消</button><button bindtap="saveName">保存</button></view></view><view class="stats"><view class="stat glass"><text>{{streak}}</text><label>连续陪伴</label></view><view class="stat glass"><text>{{coins}}</text><label>陪伴币</label></view><view class="stat glass"><text>{{totalCare}}</text><label>互动次数</label></view></view><text class="section">Petday 设置</text><view class="menu glass"><view class="menu-item"><text class="menu-icon purple">♧</text><text>我的宠物档案</text><text class="chevron">›</text></view><view class="menu-item" bindtap="contact"><text class="menu-icon peach">♡</text><text>关于 Petday</text><text class="chevron">›</text></view></view><view class="footer">愿每一次陪伴，都有回应。</view></view></scroll-view>
