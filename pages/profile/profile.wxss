page{background:#f6f5ff;color:#373447;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{height:100vh}.wrap{padding:52rpx 32rpx 90rpx}.top{display:flex;justify-content:space-between;align-items:center;margin:0 8rpx 42rpx}.eyebrow{display:block;color:#9b94ab;font-size:18rpx;letter-spacing:2rpx}.title{display:block;margin-top:10rpx;font-size:50rpx;font-weight:700;letter-spacing:-2rpx}.back{width:66rpx;height:66rpx;border-radius:25rpx;background:rgba(255,255,255,.72);display:flex;align-items:center;justify-content:center;font-size:48rpx;color:#7d7690}.glass{background:rgba(255,255,255,.67);border:2rpx solid rgba(255,255,255,.9);box-shadow:0 15rpx 40rpx rgba(83,65,138,.09)}.profile-card{display:flex;align-items:center;padding:28rpx;border-radius:34rpx}.pet-avatar{width:95rpx;height:95rpx;border-radius:34rpx;background:linear-gradient(135deg,#fce8bf,#ffd6d2);display:flex;align-items:center;justify-content:center;font-size:48rpx}.profile-info{flex:1;margin-left:20rpx}.profile-name{display:block;font-size:32rpx;font-weight:700}.profile-info text:last-child{display:block;margin-top:7rpx;color:#8d8798;font-size:20rpx}.edit{padding:10rpx 16rpx;border-radius:20rpx;background:#eee9ff;color:#806bc1;font-size:20rpx}.name-editor{padding:24rpx;margin-top:16rpx;border-radius:27rpx;font-size:23rpx;font-weight:600}.name-editor input{height:70rpx;margin:17rpx 0;border-bottom:2rpx solid #dfd7f3;font-size:26rpx}.name-editor view{display:flex;justify-content:flex-end;gap:15rpx}.name-editor button{margin:0;padding:0 20rpx;height:54rpx;line-height:54rpx;border-radius:27rpx;background:#967fd5;color:#fff;font-size:19rpx}.name-editor button:after{border:0}.name-editor .cancel{background:#eeeaf7;color:#827b91}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:23rpx}.stat{padding:24rpx 9rpx;border-radius:27rpx;text-align:center}.stat text{display:block;font-size:34rpx;font-weight:700;color:#7663ad}.stat label{display:block;margin-top:7rpx;color:#908999;font-size:18rpx}.section{display:block;margin:42rpx 8rpx 20rpx;font-size:30rpx;font-weight:700}.menu{border-radius:29rpx;overflow:hidden}.menu-item{height:96rpx;padding:0 24rpx;display:flex;align-items:center;border-bottom:1rpx solid rgba(123,112,150,.1);font-size:24rpx}.menu-item:last-child{border:0}.menu-icon{width:48rpx;height:48rpx;margin-right:17rpx;border-radius:17rpx;display:flex;align-items:center;justify-content:center}.purple{color:#816cbe;background:#eee9ff}.peach{color:#df8a9f;background:#ffe7ed}.chevron{margin-left:auto;color:#9c95a5;font-size:40rpx}.footer{text-align:center;margin-top:48rpx;color:#aaa3b3;font-size:19rpx}
.pet-avatar{overflow:hidden;background:linear-gradient(135deg,#fce8bf,#e4d7ff);box-shadow:inset 0 2rpx rgba(255,255,255,.8)}.pet-avatar image{width:118rpx;height:118rpx;margin-top:11rpx}
.wrap{padding-bottom:calc(90rpx + env(safe-area-inset-bottom));}
@import "../../styles/mobile.wxss";
